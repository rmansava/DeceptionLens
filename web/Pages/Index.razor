    private async Task HandleDiskFileSelected(InputFileChangeEventArgs e)
    {
        diskSelectedFile = e.File;

        using var ms = new MemoryStream();
        await diskSelectedFile.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024).CopyToAsync(ms);
