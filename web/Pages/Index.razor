    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await JSRuntime.InvokeVoidAsync("deceptionLensDragDrop.bind", "disk-upload-area", "disk-file-input");
        await JSRuntime.InvokeVoidAsync("deceptionLensDragDrop.bind", "clip-upload-area", "clip-file-input");
        await JSRuntime.InvokeVoidAsync("deceptionLensDragDrop.bind", "face-upload-area", "face-file-input");
    }

    private async Task LoadCollections()
    {
        try
        {
            var cols = await SearchService.GetCollectionsAsync();
            if (cols.Any())
            {
                var baseNames = cols
                    .Select(c => c.Replace("_visual", "").Replace("_faces", ""))
                    .Distinct()
                    .ToList();

                if (baseNames.Any())
                {
                    // Add "all" option at the beginning for searching all collections
                    collections = new List<string> { "all" };
                    collections.AddRange(baseNames);
                    selectedCollection = "all"; // Default to searching all
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load collections");
        }
    }

