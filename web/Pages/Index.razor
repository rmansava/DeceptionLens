    private double GetDiskProgressPercent(SearchHistoryDetail detail)
    {
        if (!detail.TotalChunks.HasValue || detail.TotalChunks.Value <= 0 || string.IsNullOrWhiteSpace(detail.CurrentProgress))
        {
            return 0;
        }

        var parts = detail.CurrentProgress.Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault();
        if (string.IsNullOrWhiteSpace(parts) || !parts.Contains('/'))
        {
            return 0;
        }

        var chunks = parts.Split('/');
        if (chunks.Length != 2 || !int.TryParse(chunks[0], out var current))
        {
            return 0;
        }

        return Math.Clamp((double)current / detail.TotalChunks.Value * 100.0, 0, 100);
    }

    private string? GetResultCollection(SearchResult result)
    {
        if (result.Metadata != null && result.Metadata.TryGetValue("collection", out var raw) && raw != null)
        {
            var value = raw.ToString();
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value;
            }
        }

        var path = result.Path?.ToLowerInvariant() ?? string.Empty;
        if (path.Contains("\\books\\") || path.Contains("/books/")) return "books";
        if (path.Contains("\\print_ads\\") || path.Contains("/print_ads/")) return "print_ads";
        if (path.Contains("\\board_games\\") || path.Contains("/board_games/")) return "board_games";
        if (path.Contains("\\cereal\\") || path.Contains("/cereal/")) return "cereal";
        if (path.Contains("\\albums\\") || path.Contains("/albums/")) return "albums";
        if (path.Contains("\\comics\\") || path.Contains("/comics/")) return "comics";
        return null;
    }

    private bool CanDeepSearch()
    {
        // Can do deep search if we have an image loaded from CLIP or DISK query.
        return (clipFileBytes != null && clipFileBytes.Length > 0) ||
               (diskFileBytes != null && diskFileBytes.Length > 0);
    }

    private async Task PerformDeepSearch()
    {
        // Use whichever image is available (prefer the one used for last search)
        byte[]? imageBytes = null;
        string fileName = "query.jpg";

        if (lastSearchType.Contains("CLIP", StringComparison.OrdinalIgnoreCase) && clipFileBytes != null)
        {
            imageBytes = clipFileBytes;
            fileName = clipSelectedFile?.Name ?? "query.jpg";
        }
        else if (lastSearchType == "Keypoint" && diskFileBytes != null)
        {
            imageBytes = diskFileBytes;
            fileName = diskSelectedFile?.Name ?? "query.jpg";
        }
        else if (clipFileBytes != null)
        {
            imageBytes = clipFileBytes;
            fileName = clipSelectedFile?.Name ?? "query.jpg";
        }
        else if (diskFileBytes != null)
        {
            imageBytes = diskFileBytes;
            fileName = diskSelectedFile?.Name ?? "query.jpg";
        }

        if (imageBytes == null || imageBytes.Length == 0) return;

        isSearching = true;
        hasSearched = true;
        errorMessage = null;
        lastSearchType = "Deep Search";
        StateHasChanged();

        try
        {
            using var ms = new MemoryStream(imageBytes);
            results = await SearchService.DeepSearchAsync(ms, fileName, topK);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Deep search failed");
            errorMessage = $"Deep search failed: {ex.Message}";
            results = new List<SearchResult>();
        }
        finally
        {
            isSearching = false;
            StateHasChanged();
        }
    }

