@page "/"
@implements IDisposable
@inject ISearchService SearchService
@inject ILogger<Index> Logger
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Deception Lens - An Image Finder</PageTitle>

<div class="search-container" @onkeydown:window="HandleGlobalKeyDown">
    <!-- Left Panel: Search Controls -->
    <aside class="search-panel">
        <!-- Shared Settings -->
        <div class="panel-section">
            <h2 class="section-title">Settings</h2>

            <!-- Collection Selector -->
            <div class="form-group">
                <label>Collection</label>
                <select @bind="selectedCollection" class="form-select">
                    @foreach (var col in collections)
                    {
                        <option value="@col">@(col == "all" ? "All Collections" : col)</option>
                    }
                </select>
            </div>

            <!-- Results Count -->
            <div class="form-group">
                <label>Results</label>
                <input type="number" @bind="topK" min="1" max="500" class="form-input" />
            </div>
        </div>

        <!-- Keypoint Search Section (Exact Crop Matching) -->
        <div class="panel-section">
            <h2 class="section-title">Keypoint Search</h2>
            <p class="search-info">Find the source of cropped images.</p>

            <!-- Keypoint Visual Search -->
            <div id="disk-upload-area" class="upload-area">

                @if (diskPreviewUrl != null)
                {
                    <img src="@diskPreviewUrl" alt="Keypoint Query" class="preview-image" />
                    <button class="clear-btn" @onclick="ClearDiskQuery">Clear</button>
                }
                else
                {
                    <div class="upload-prompt">
                        <svg class="upload-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        <p>Drop cropped image here</p>
                    </div>
                }

                <InputFile id="disk-file-input" OnChange="HandleDiskFileSelected" accept="image/*" class="file-input" />
            </div>
            <button class="search-btn disk-search-btn" @onclick="PerformDiskImageSearch"
                    disabled="@(diskFileBytes == null || diskFileBytes.Length == 0 || isSearching)">
                Find Source Page
            </button>
        </div>

        <!-- CLIP Section -->
        <div class="panel-section">
            <h2 class="section-title">CLIP Search</h2>
            <p class="search-info">Semantic lookup by text or image. Finds visually or conceptually similar content.</p>

            <!-- CLIP Text Search -->
            <div class="form-group">
                <label>Text Search</label>
                <div class="text-search-row">
                    <input type="text" @bind="textQuery" @bind:event="oninput"
                           @onkeydown="HandleTextKeyDown"
                           placeholder="e.g., truck, red car, sunset..."
                           class="form-input text-search-input" />
                    <button class="search-btn" @onclick="PerformTextSearch" disabled="@(string.IsNullOrWhiteSpace(textQuery) || isSearching)">
                        Go
                    </button>
                </div>
            </div>

            <!-- CLIP Visual Search -->
            <div class="form-group">
                <label>Visual Search</label>
            </div>
            <div id="clip-upload-area" class="upload-area">

                @if (clipPreviewUrl != null)
                {
                    <img src="@clipPreviewUrl" alt="CLIP Query" class="preview-image" />
                    <button class="clear-btn" @onclick="ClearClipQuery">Clear</button>
                }
                else
                {
                    <div class="upload-prompt">
                        <svg class="upload-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        <p>Drop image here</p>
                    </div>
                }

                <InputFile id="clip-file-input" OnChange="HandleClipFileSelected" accept="image/*" class="file-input" />
            </div>
            <button class="search-btn clip-search-btn" @onclick="PerformClipImageSearch"
                    disabled="@(clipFileBytes == null || clipFileBytes.Length == 0 || isSearching)">
                Search with CLIP
            </button>
        </div>

        <!-- Face Search Section -->
        <div class="panel-section">
            <h2 class="section-title">Face Search</h2>
            <p class="search-info">Find matching faces using ArcFace recognition. Upload a photo with a face to find similar faces.</p>

            <div id="face-upload-area" class="upload-area">

                @if (facePreviewUrl != null)
                {
                    <img src="@facePreviewUrl" alt="Face Query" class="preview-image" />
                    <button class="clear-btn" @onclick="ClearFaceQuery">Clear</button>
                }
                else
                {
                    <div class="upload-prompt">
                        <svg class="upload-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        <p>Drop face image</p>
                    </div>
                }

                <InputFile id="face-file-input" OnChange="HandleFaceFileSelected" accept="image/*" class="file-input" />
            </div>
            <button class="search-btn face-search-btn" @onclick="PerformFaceSearch"
                    disabled="@(faceFileBytes == null || faceFileBytes.Length == 0 || isSearching)">
                Search Faces
            </button>
        </div>

        <!-- Stats -->
        <div class="panel-section stats-section">
            <h3 class="section-title-sm">Statistics</h3>
            @if (stats != null)
            {
                <p>DINOv2: <span class="stat-value">@stats.VisualCount.ToString("N0")</span> images</p>
            }
            @if (clipStats != null)
            {
                <p>CLIP: <span class="stat-value">@clipStats.TotalImages.ToString("N0")</span> images</p>
            }
            @if (stats == null && clipStats == null)
            {
                <p class="text-muted">Loading...</p>
            }
        </div>

        <!-- Status -->
        <div class="panel-section status-section">
            <p>Status: <span class="@(isSearching ? "status-searching" : "status-ready")">@(isSearching ? "Searching..." : "Ready")</span></p>
            <p>Found: <span class="stat-value">@results.Count</span> matches</p>
            @if (!string.IsNullOrEmpty(lastSearchType))
            {
                <p class="text-muted">Last: @lastSearchType</p>
            }
        </div>
    </aside>

    <!-- Right Panel: Results -->
    <section class="results-panel">
        <div class="results-header">
            <div class="results-title-row">
                <h2>Results</h2>
                <button class="history-btn" @onclick="GoToHistory" title="Search History">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12,6 12,12 16,14"/>
                    </svg>
                    History
                </button>
                @if (results.Any())
                {
                    <span class="results-subtitle">
                        @if (lastSearchType == "Deep Search")
                        {
                            @:CLIP + DINOv2 + Template Matching
                        }
                        else if (lastSearchType == "DINOv2 Visual")
                        {
                            @:Sorted by verified matches
                        }
                        else
                        {
                            @:Sorted by similarity score
                        }
                    </span>
                }
                @if (results.Any() && CanDeepSearch() && lastSearchType != "Deep Search")
                {
                    <button class="deep-search-btn" @onclick="PerformDeepSearch" disabled="@isSearching">
                        Deeper Search
                    </button>
                }
            </div>
            <div class="thumbnail-size-selector">
                <button class="size-btn @(thumbnailSize == "small" ? "active" : "")" @onclick="@(() => thumbnailSize = "small")" title="Small thumbnails">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <rect x="1" y="1" width="3" height="3" /><rect x="6" y="1" width="3" height="3" /><rect x="11" y="1" width="3" height="3" />
                        <rect x="1" y="6" width="3" height="3" /><rect x="6" y="6" width="3" height="3" /><rect x="11" y="6" width="3" height="3" />
                        <rect x="1" y="11" width="3" height="3" /><rect x="6" y="11" width="3" height="3" /><rect x="11" y="11" width="3" height="3" />
                    </svg>
                </button>
                <button class="size-btn @(thumbnailSize == "medium" ? "active" : "")" @onclick="@(() => thumbnailSize = "medium")" title="Medium thumbnails">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <rect x="1" y="1" width="6" height="6" /><rect x="9" y="1" width="6" height="6" />
                        <rect x="1" y="9" width="6" height="6" /><rect x="9" y="9" width="6" height="6" />
                    </svg>
                </button>
                <button class="size-btn @(thumbnailSize == "large" ? "active" : "")" @onclick="@(() => thumbnailSize = "large")" title="Large thumbnails">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <rect x="1" y="1" width="14" height="6" />
                        <rect x="1" y="9" width="14" height="6" />
                    </svg>
                </button>
            </div>
        </div>

        @if (errorMessage != null)
        {
            <div class="error-message">
                @errorMessage
            </div>
        }

        @if (isSearching)
        {
            <div class="loading-container">
                <div class="spinner"></div>
                <p class="progress-main">@searchProgressMessage</p>
                @if (activeDiskSearchId.HasValue && currentDiskSearch != null)
                {
                    @if (currentDiskSearch.TotalChunks.GetValueOrDefault() > 0)
                    {
                        <div class="progress-details">
                            <div class="progress-bar-container">
                                <div class="progress-bar" style="width: @(GetDiskProgressPercent(currentDiskSearch))%"></div>
                            </div>
                        </div>
                    }
                    <button class="search-btn" @onclick="StopActiveDiskSearch">
                        Cancel DISK Search
                    </button>
                }
            </div>
        }
        else if (!results.Any() && hasSearched)
        {
            <div class="no-results">
                <p>No results found. Try a different query.</p>
            </div>
        }
        else
        {
            <div class="results-grid results-grid-@thumbnailSize">
                @foreach (var (result, index) in results.Select((r, i) => (r, i)))
                {
                    <div class="result-card">
                        <div class="result-image-container" @ondblclick="() => OpenImage(result.Path)">
                            <img src="@SearchService.GetImageUrl(result.Path)"
                                 alt="Result @(index + 1)"
                                 loading="lazy"
                                 @onerror="HandleImageError" />
                            <span class="rank-badge">#@(index + 1)</span>
                        </div>
                        <div class="result-info">
                            <h3 class="result-filename" title="@result.Path">@result.FileName</h3>
                            <div class="result-stats">
                                @if (selectedCollection == "all" && !string.IsNullOrEmpty(GetResultCollection(result)))
                                {
                                    <span class="verified-badge">@GetResultCollection(result)</span>
                                }
                                @if (lastSearchType == "DINOv2 Visual" && result.VerifiedMatches > 0)
                                {
                                    <span class="verified-badge verified-positive">
                                        @result.VerifiedMatches verified
                                    </span>
                                }
                                <span class="score-badge">Score: @result.Score.ToString("F4")</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- History Panel -->
    @if (showHistoryPanel)
    {
        <div class="history-overlay" @onclick="ToggleHistoryPanel"></div>
        <aside class="history-panel">
            <div class="history-panel-header">
                <h3>Search History</h3>
                <button class="close-btn" @onclick="ToggleHistoryPanel">&times;</button>
            </div>
            @if (isLoadingHistory)
            {
                <div class="history-loading">
                    <div class="spinner-sm"></div>
                    <span>Loading...</span>
                </div>
            }
            else if (historyEntries == null || !historyEntries.Any())
            {
                <div class="history-empty">
                    <p>No search history yet.</p>
                </div>
            }
            else
            {
                <div class="history-list">
                    @foreach (var entry in historyEntries)
                    {
                        <div class="history-item" @onclick="() => LoadHistoryEntry(entry.Id)">
                            <div class="history-item-image">
                                @if (!string.IsNullOrEmpty(entry.QueryImageName))
                                {
                                    <img src="@SearchService.GetSearchHistoryImageUrl(entry.Id)" alt="Query" />
                                }
                                else if (!string.IsNullOrEmpty(entry.QueryText))
                                {
                                    <div class="history-text-icon">T</div>
                                }
                                else
                                {
                                    <div class="history-no-image">?</div>
                                }
                            </div>
                            <div class="history-item-info">
                                <span class="history-type @GetHistoryTypeCssClass(entry.SearchType)">@entry.SearchType</span>
                                <span class="history-date">@FormatHistoryDate(entry.ParsedDate)</span>
                                <span class="history-results">@entry.ResultCount results</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </aside>
    }

    <!-- Fullscreen Image Popup -->
    @if (showImagePopup && !string.IsNullOrEmpty(popupImageUrl))
    {
        <div class="image-popup-overlay" @onclick="CloseImagePopup">
            <div class="image-popup-container">
                <button class="popup-close-btn" @onclick="CloseImagePopup">&times;</button>
                <img src="@popupImageUrl" alt="Full size image" class="popup-image"
                     @onclick:stopPropagation @ondblclick="CloseImagePopup" />
            </div>
        </div>
    }
</div>

<style>
    .text-search-row {
        display: flex;
        gap: 8px;
    }

    .text-search-input {
        flex: 1;
    }

    .search-btn {
        padding: 8px 16px;
        background: #3b82f6;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-weight: 500;
    }

    .search-btn:hover:not(:disabled) {
        background: #2563eb;
    }

    .search-btn:disabled {
        background: #9ca3af;
        cursor: not-allowed;
    }

    .clip-search-btn {
        width: 100%;
        margin-top: 10px;
        padding: 10px 16px;
    }

    .clip-search-btn {
        background: linear-gradient(135deg, #3b82f6, #2563eb);
    }

    .clip-search-btn:hover:not(:disabled) {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
    }

    .disk-search-btn {
        width: 100%;
        margin-top: 10px;
        padding: 10px 16px;
        background: linear-gradient(135deg, #f59e0b, #d97706);
    }

    .disk-search-btn:hover:not(:disabled) {
        background: linear-gradient(135deg, #d97706, #b45309);
    }

    .search-warning {
        font-size: 0.75rem;
        color: #f59e0b;
        margin: 4px 0 8px 0;
        padding: 4px 8px;
        background: rgba(245, 158, 11, 0.1);
        border-radius: 4px;
        border-left: 2px solid #f59e0b;
    }

    .progress-main {
        font-size: 1rem;
        color: #e5e7eb;
        margin-bottom: 8px;
    }

    .progress-details {
        margin-top: 12px;
        padding: 12px;
        background: rgba(55, 65, 81, 0.5);
        border-radius: 8px;
        min-width: 280px;
    }

    .progress-bar-container {
        height: 6px;
        background: #374151;
        border-radius: 3px;
        overflow: hidden;
        margin-bottom: 10px;
    }

    .progress-bar {
        height: 100%;
        background: linear-gradient(90deg, #3b82f6, #60a5fa);
        border-radius: 3px;
        transition: width 0.3s ease;
    }

    .divider-text {
        text-align: center;
        color: #6b7280;
        font-size: 0.875rem;
        margin: 12px 0;
        position: relative;
    }

    .divider-text::before,
    .divider-text::after {
        content: '';
        position: absolute;
        top: 50%;
        width: 30%;
        height: 1px;
        background: #374151;
    }

    .divider-text::before {
        left: 0;
    }

    .divider-text::after {
        right: 0;
    }

    /* Results header layout */
    .results-title-row {
        display: flex;
        align-items: baseline;
        gap: 12px;
    }

    /* Thumbnail grid styles are in wwwroot/css/results-shared.css */

    /* Deep Search button */
    .deep-search-btn {
        padding: 6px 14px;
        background: linear-gradient(135deg, #8b5cf6, #3b82f6);
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.2s;
        margin-left: auto;
    }

    .deep-search-btn:hover:not(:disabled) {
        background: linear-gradient(135deg, #7c3aed, #2563eb);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
    }

    .deep-search-btn:disabled {
        background: #6b7280;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    /* History button */
    .history-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        background: #374151;
        color: #d1d5db;
        border: 1px solid #4b5563;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.85rem;
        transition: all 0.2s;
    }

    .history-btn:hover {
        background: #4b5563;
        color: #f3f4f6;
    }

    /* History panel overlay */
    .history-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 100;
    }

    /* History panel */
    .history-panel {
        position: fixed;
        top: 0;
        right: 0;
        width: 320px;
        height: 100vh;
        background: #1f2937;
        border-left: 1px solid #374151;
        z-index: 101;
        display: flex;
        flex-direction: column;
        animation: slideIn 0.2s ease-out;
    }

    @@keyframes slideIn {
        from { transform: translateX(100%); }
        to { transform: translateX(0); }
    }

    .history-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px;
        border-bottom: 1px solid #374151;
    }

    .history-panel-header h3 {
        margin: 0;
        color: #f3f4f6;
        font-size: 1.1rem;
    }

    .close-btn {
        background: transparent;
        border: none;
        color: #9ca3af;
        font-size: 24px;
        cursor: pointer;
        line-height: 1;
    }

    .close-btn:hover {
        color: #f3f4f6;
    }

    .history-loading, .history-empty {
        padding: 40px 20px;
        text-align: center;
        color: #9ca3af;
    }

    .spinner-sm {
        width: 24px;
        height: 24px;
        border: 2px solid #374151;
        border-top-color: #3b82f6;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 12px;
    }

    .history-list {
        flex: 1;
        overflow-y: auto;
        padding: 8px;
    }

    .history-item {
        display: flex;
        gap: 12px;
        padding: 10px;
        background: #111827;
        border-radius: 8px;
        margin-bottom: 8px;
        cursor: pointer;
        transition: all 0.15s;
    }

    .history-item:hover {
        background: #1e3a5f;
        transform: translateX(-4px);
    }

    .history-item-image {
        width: 50px;
        height: 50px;
        flex-shrink: 0;
        border-radius: 6px;
        overflow: hidden;
        background: #374151;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .history-item-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .history-text-icon, .history-no-image {
        color: #9ca3af;
        font-size: 1.2rem;
        font-weight: bold;
    }

    .history-item-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
    }

    .history-type {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 2px 6px;
        border-radius: 4px;
        width: fit-content;
    }

    .history-type.dino { background: #7c3aed; color: white; }
    .history-type.clip { background: #3b82f6; color: white; }
    .history-type.deep { background: linear-gradient(135deg, #8b5cf6, #3b82f6); color: white; }
    .history-type.face { background: #10b981; color: white; }
    .history-type.text { background: #f59e0b; color: black; }

    .history-date {
        font-size: 0.75rem;
        color: #9ca3af;
    }

    .history-results {
        font-size: 0.8rem;
        color: #d1d5db;
    }

    /* Fullscreen Image Popup */
    .image-popup-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.95);
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        animation: fadeIn 0.2s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .image-popup-container {
        position: relative;
        max-width: 95vw;
        max-height: 95vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .popup-image {
        max-width: 95vw;
        max-height: 95vh;
        object-fit: contain;
        cursor: zoom-out;
        border-radius: 4px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    }

    .popup-close-btn {
        position: fixed;
        top: 20px;
        right: 20px;
        width: 48px;
        height: 48px;
        background: rgba(255, 255, 255, 0.1);
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        color: white;
        font-size: 28px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        z-index: 201;
    }

    .popup-close-btn:hover {
        background: rgba(255, 255, 255, 0.2);
        border-color: rgba(255, 255, 255, 0.5);
        transform: scale(1.1);
    }

    /* Make result images show they're double-clickable */
    .result-image-container {
        cursor: zoom-in;
    }

</style>

@code {
    private List<string> collections = new() { "books" };
    private string selectedCollection = "books";
    private int topK = 50;
    private string textQuery = "";
    private string lastSearchType = "";
    private string thumbnailSize = "medium";

    private List<SearchResult> results = new();
    private StatsResponse? stats;
    private ClipStatsResponse? clipStats;
    private string? errorMessage;
    private string searchProgressMessage = "Searching...";
    private bool isSearching = false;
    private bool hasSearched = false;
    // CLIP file state
    private string? clipPreviewUrl;
    private IBrowserFile? clipSelectedFile;
    private byte[]? clipFileBytes;

    // Face file state
    private string? facePreviewUrl;
    private IBrowserFile? faceSelectedFile;
