        await clipSelectedFile.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024).CopyToAsync(ms);
        clipFileBytes = ms.ToArray();

        clipPreviewUrl = $"data:{clipSelectedFile.ContentType};base64,{Convert.ToBase64String(clipFileBytes)}";
