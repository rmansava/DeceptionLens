    private async Task LoadHistoryEntry(int searchId)
    {
        showHistoryPanel = false;
        isSearching = true;
        hasSearched = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var detail = await SearchService.GetSearchHistoryDetailAsync(searchId);
            if (detail != null)
            {
                lastSearchType = detail.SearchType;
                results = detail.Results.Select(r => new SearchResult
                {
                    Path = r.ImagePath,
                    Score = r.Score,
                    VerifiedMatches = r.VerifiedMatches ?? 0
                }).ToList();

                // Load the query image if available
                if (!string.IsNullOrEmpty(detail.QueryImageName))
                {
                    var imageUrl = SearchService.GetSearchHistoryImageUrl(searchId);
                    if (detail.SearchType.Contains("CLIP"))
                    {
                        clipPreviewUrl = imageUrl;
                    }
                    else if (detail.SearchType.Contains("DINOv2"))
                    {
                        dinoPreviewUrl = imageUrl;
                    }
                    else if (detail.SearchType.Contains("Face"))
                    {
                        facePreviewUrl = imageUrl;
                    }
                }

                // Set text query if it was a text search
                if (!string.IsNullOrEmpty(detail.QueryText))
                {
                    textQuery = detail.QueryText;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load history entry");
            errorMessage = $"Failed to load history: {ex.Message}";
            results = new List<SearchResult>();
        }
        finally
        {
            isSearching = false;
            StateHasChanged();
        }
    }

    private string GetHistoryTypeCssClass(string searchType)
    {
        return searchType switch
        {
            "DINOv2 Visual" => "dino",
            "CLIP Visual" => "clip",
            "Deep Search" => "deep",
            "Face Search" => "face",
            _ when searchType.Contains("Text") => "text",
            _ => ""
        };
    }

    private string FormatHistoryDate(DateTime date)
    {
        if (date.Date == DateTime.Today)
            return $"Today {date:HH:mm}";
        if (date.Date == DateTime.Today.AddDays(-1))
            return $"Yesterday {date:HH:mm}";
        return date.ToString("MMM d, HH:mm");
    }
