        StateHasChanged();
    }

    private async Task PerformDiskImageSearch()
    {
        if (diskSelectedFile == null || diskFileBytes == null || diskFileBytes.Length == 0) return;

        diskSearchPollCts?.Cancel();
        diskSearchPollCts?.Dispose();
        diskSearchPollCts = new CancellationTokenSource();

        isSearching = true;
        hasSearched = true;
        errorMessage = null;
        lastSearchType = "Keypoint";
        searchProgressMessage = "Queueing DISK search...";
        currentDiskSearch = null;
        activeDiskSearchId = null;
        results = new List<SearchResult>();
        StateHasChanged();

        try
        {
            using var ms = new MemoryStream(diskFileBytes);
            var start = await SearchService.DiskSearchAsync(
                ms,
                diskSelectedFile.Name,
                topK,
                selectedCollection
            );

            if (start == null || start.SearchId <= 0)
            {
                throw new InvalidOperationException("DISK search was not queued");
            }

            activeDiskSearchId = start.SearchId;
            searchProgressMessage = start.Message;
            _ = PollDiskSearchAsync(start.SearchId, diskSearchPollCts.Token);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "DISK search failed");
            errorMessage = $"DISK search failed: {ex.Message}";
            results = new List<SearchResult>();
            isSearching = false;
            activeDiskSearchId = null;
            currentDiskSearch = null;
            StateHasChanged();
        }
    }

    private async Task PollDiskSearchAsync(int searchId, CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(1000, cancellationToken);

                var detail = await SearchService.GetSearchHistoryDetailAsync(searchId);
                if (detail == null)
                {
                    continue;
                }

                currentDiskSearch = detail;
                if (!string.IsNullOrWhiteSpace(detail.Notes))
                {
                    searchProgressMessage = detail.Notes;
                }
                else if (!string.IsNullOrWhiteSpace(detail.CurrentProgress))
                {
                    searchProgressMessage = detail.CurrentProgress;
                }

                results = detail.Results
                    .OrderBy(r => r.Rank)
                    .Select(r => new SearchResult
                    {
                        Path = r.ImagePath,
                        Score = r.Score,
                        VerifiedMatches = r.VerifiedMatches ?? 0
                    })
                    .ToList();

                if (!detail.IsInProgress)
                {
                    isSearching = false;
                    activeDiskSearchId = null;
                    if (string.Equals(detail.Status, "stopped", StringComparison.OrdinalIgnoreCase))
                    {
                        errorMessage = "DISK search stopped.";
                    }
                    else if (string.Equals(detail.Status, "failed", StringComparison.OrdinalIgnoreCase))
                    {
                        errorMessage = "DISK search failed.";
                    }
                    else if (results.Count == 0)
                    {
                        errorMessage = "No keypoint matches found";
                    }
                    await InvokeAsync(StateHasChanged);
                    break;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
            // Expected when a new DISK search starts or user cancels.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "DISK polling failed");
            errorMessage = $"DISK polling failed: {ex.Message}";
            isSearching = false;
            activeDiskSearchId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ClearDiskQuery()
    {
        diskSelectedFile = null;
        diskFileBytes = null;
        diskPreviewUrl = null;
    }

    private async Task StopActiveDiskSearch()
    {
        if (!activeDiskSearchId.HasValue)
        {
            return;
        }

        var stopped = await SearchService.StopSearchAsync(activeDiskSearchId.Value);
        if (!stopped)
        {
            errorMessage = "Failed to stop DISK search.";
            StateHasChanged();
            return;
        }

        searchProgressMessage = "Stopping DISK search...";
        StateHasChanged();
    }

