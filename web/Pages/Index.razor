@page "/"
@inject ISearchService SearchService
@inject ILogger<Index> Logger

<PageTitle>Deception Lens - An Image Finder</PageTitle>

<div class="search-container">
    <!-- Left Panel: Search Controls -->
    <aside class="search-panel">
        <!-- Shared Settings -->
        <div class="panel-section">
            <h2 class="section-title">Settings</h2>

            <!-- Collection Selector -->
            <div class="form-group">
                <label>Collection</label>
                <select @bind="selectedCollection" class="form-select">
                    @foreach (var col in collections)
                    {
                        <option value="@col">@col</option>
                    }
                </select>
            </div>

            <!-- Results Count -->
            <div class="form-group">
                <label>Results</label>
                <input type="number" @bind="topK" min="1" max="500" class="form-input" />
            </div>
        </div>

        <!-- DINOv2 Section -->
        <div class="panel-section">
            <h2 class="section-title">DINOv2 Search</h2>

            <!-- Verify Checkbox -->
            <div class="form-group checkbox-group">
                <input type="checkbox" @bind="verify" id="verifyCheck" />
                <label for="verifyCheck">Geometric Verification</label>
            </div>

            <!-- DINOv2 Visual Search -->
            <div class="upload-area @(isDragging ? "dragging" : "")"
                 @ondragenter="HandleDragEnter"
                 @ondragleave="HandleDragLeave"
                 @ondragover:preventDefault
                 @ondrop="HandleDrop"
                 @ondrop:preventDefault>

                @if (dinoPreviewUrl != null)
                {
                    <img src="@dinoPreviewUrl" alt="DINOv2 Query" class="preview-image" />
                    <button class="clear-btn" @onclick="ClearDinoQuery">Clear</button>
                }
                else
                {
                    <div class="upload-prompt">
                        <svg class="upload-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        <p>Drop image here</p>
                    </div>
                }

                <InputFile OnChange="HandleDinoFileSelected" accept="image/*" class="file-input" />
            </div>
        </div>

        <!-- CLIP Section -->
        <div class="panel-section">
            <h2 class="section-title">CLIP Search</h2>

            <!-- CLIP Text Search -->
            <div class="form-group">
                <label>Text Search</label>
                <div class="text-search-row">
                    <input type="text" @bind="textQuery" @bind:event="oninput"
                           @onkeydown="HandleTextKeyDown"
                           placeholder="e.g., truck, red car, sunset..."
                           class="form-input text-search-input" />
                    <button class="search-btn" @onclick="PerformTextSearch" disabled="@(string.IsNullOrWhiteSpace(textQuery) || isSearching)">
                        Go
                    </button>
                </div>
            </div>

            <!-- CLIP Visual Search -->
            <div class="form-group">
                <label>Visual Search</label>
            </div>
            <div class="upload-area @(isDragging ? "dragging" : "")"
                 @ondragenter="HandleDragEnter"
                 @ondragleave="HandleDragLeave"
                 @ondragover:preventDefault
                 @ondrop="HandleDrop"
                 @ondrop:preventDefault>

                @if (clipPreviewUrl != null)
                {
                    <img src="@clipPreviewUrl" alt="CLIP Query" class="preview-image" />
                    <button class="clear-btn" @onclick="ClearClipQuery">Clear</button>
                }
                else
                {
                    <div class="upload-prompt">
                        <svg class="upload-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        <p>Drop image here</p>
                    </div>
                }

                <InputFile OnChange="HandleClipFileSelected" accept="image/*" class="file-input" />
            </div>
        </div>

        <!-- Face Search Section -->
        <div class="panel-section">
            <h2 class="section-title">Face Search</h2>

            <div class="upload-area @(isDragging ? "dragging" : "")"
                 @ondragenter="HandleDragEnter"
                 @ondragleave="HandleDragLeave"
                 @ondragover:preventDefault
                 @ondrop="HandleDrop"
                 @ondrop:preventDefault>

                @if (facePreviewUrl != null)
                {
                    <img src="@facePreviewUrl" alt="Face Query" class="preview-image" />
                    <button class="clear-btn" @onclick="ClearFaceQuery">Clear</button>
                }
                else
                {
                    <div class="upload-prompt">
                        <svg class="upload-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        <p>Drop face image</p>
                    </div>
                }

                <InputFile OnChange="HandleFaceFileSelected" accept="image/*" class="file-input" />
            </div>
        </div>

        <!-- Stats -->
        <div class="panel-section stats-section">
            <h3 class="section-title-sm">Statistics</h3>
            @if (stats != null)
            {
                <p>DINOv2: <span class="stat-value">@stats.VisualCount.ToString("N0")</span> images</p>
            }
            @if (clipStats != null)
            {
                <p>CLIP: <span class="stat-value">@clipStats.TotalImages.ToString("N0")</span> images</p>
            }
            @if (stats == null && clipStats == null)
            {
                <p class="text-muted">Loading...</p>
            }
        </div>

        <!-- Status -->
        <div class="panel-section status-section">
            <p>Status: <span class="@(isSearching ? "status-searching" : "status-ready")">@(isSearching ? "Searching..." : "Ready")</span></p>
            <p>Found: <span class="stat-value">@results.Count</span> matches</p>
            @if (!string.IsNullOrEmpty(lastSearchType))
            {
                <p class="text-muted">Last: @lastSearchType</p>
            }
        </div>
    </aside>

    <!-- Right Panel: Results -->
    <section class="results-panel">
        <div class="results-header">
            <div class="results-title-row">
                <h2>Results</h2>
                <button class="history-btn" @onclick="ToggleHistoryPanel" title="Search History">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12,6 12,12 16,14"/>
                    </svg>
                    History
                </button>
                @if (results.Any())
                {
                    <span class="results-subtitle">
                        @if (lastSearchType == "Deep Search")
                        {
                            @:CLIP + DINOv2 + Template Matching
                        }
                        else if (lastSearchType == "DINOv2 Visual" && verify)
                        {
                            @:Sorted by verified matches
                        }
                        else
                        {
                            @:Sorted by similarity score
                        }
                    </span>
                }
                @if (results.Any() && CanDeepSearch() && lastSearchType != "Deep Search")
                {
                    <button class="deep-search-btn" @onclick="PerformDeepSearch" disabled="@isSearching">
                        Deeper Search
                    </button>
                }
            </div>
            <div class="thumbnail-size-selector">
                <button class="size-btn @(thumbnailSize == "small" ? "active" : "")" @onclick="@(() => thumbnailSize = "small")" title="Small thumbnails">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <rect x="1" y="1" width="3" height="3" /><rect x="6" y="1" width="3" height="3" /><rect x="11" y="1" width="3" height="3" />
                        <rect x="1" y="6" width="3" height="3" /><rect x="6" y="6" width="3" height="3" /><rect x="11" y="6" width="3" height="3" />
                        <rect x="1" y="11" width="3" height="3" /><rect x="6" y="11" width="3" height="3" /><rect x="11" y="11" width="3" height="3" />
                    </svg>
                </button>
                <button class="size-btn @(thumbnailSize == "medium" ? "active" : "")" @onclick="@(() => thumbnailSize = "medium")" title="Medium thumbnails">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <rect x="1" y="1" width="6" height="6" /><rect x="9" y="1" width="6" height="6" />
                        <rect x="1" y="9" width="6" height="6" /><rect x="9" y="9" width="6" height="6" />
                    </svg>
                </button>
                <button class="size-btn @(thumbnailSize == "large" ? "active" : "")" @onclick="@(() => thumbnailSize = "large")" title="Large thumbnails">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <rect x="1" y="1" width="14" height="6" />
                        <rect x="1" y="9" width="14" height="6" />
                    </svg>
                </button>
            </div>
        </div>

        @if (errorMessage != null)
        {
            <div class="error-message">
                @errorMessage
            </div>
        }

        @if (isSearching)
        {
            <div class="loading-container">
                <div class="spinner"></div>
                <p>Searching...</p>
            </div>
        }
        else if (!results.Any() && hasSearched)
        {
            <div class="no-results">
                <p>No results found. Try a different query.</p>
            </div>
        }
        else
        {
            <div class="results-grid results-grid-@thumbnailSize">
                @foreach (var (result, index) in results.Select((r, i) => (r, i)))
                {
                    <div class="result-card">
                        <div class="result-image-container" @ondblclick="() => OpenImage(result.Path)">
                            <img src="@SearchService.GetImageUrl(result.Path)"
                                 alt="Result @(index + 1)"
                                 loading="lazy"
                                 @onerror="HandleImageError" />
                            <span class="rank-badge">#@(index + 1)</span>
                        </div>
                        <div class="result-info">
                            <h3 class="result-filename" title="@result.Path">@result.FileName</h3>
                            <div class="result-stats">
                                @if (lastSearchType == "DINOv2 Visual" && verify && result.VerifiedMatches > 0)
                                {
                                    <span class="verified-badge verified-positive">
                                        @result.VerifiedMatches verified
                                    </span>
                                }
                                <span class="score-badge">Score: @result.Score.ToString("F4")</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- History Panel -->
    @if (showHistoryPanel)
    {
        <div class="history-overlay" @onclick="ToggleHistoryPanel"></div>
        <aside class="history-panel">
            <div class="history-panel-header">
                <h3>Search History</h3>
                <button class="close-btn" @onclick="ToggleHistoryPanel">&times;</button>
            </div>
            @if (isLoadingHistory)
            {
                <div class="history-loading">
                    <div class="spinner-sm"></div>
                    <span>Loading...</span>
                </div>
            }
            else if (historyEntries == null || !historyEntries.Any())
            {
                <div class="history-empty">
                    <p>No search history yet.</p>
                </div>
            }
            else
            {
                <div class="history-list">
                    @foreach (var entry in historyEntries)
                    {
                        <div class="history-item" @onclick="() => LoadHistoryEntry(entry.Id)">
                            <div class="history-item-image">
                                @if (!string.IsNullOrEmpty(entry.QueryImageName))
                                {
                                    <img src="@SearchService.GetSearchHistoryImageUrl(entry.Id)" alt="Query" />
                                }
                                else if (!string.IsNullOrEmpty(entry.QueryText))
                                {
                                    <div class="history-text-icon">T</div>
                                }
                                else
                                {
                                    <div class="history-no-image">?</div>
                                }
                            </div>
                            <div class="history-item-info">
                                <span class="history-type @GetHistoryTypeCssClass(entry.SearchType)">@entry.SearchType</span>
                                <span class="history-date">@FormatHistoryDate(entry.ParsedDate)</span>
                                <span class="history-results">@entry.ResultCount results</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </aside>
    }

    <!-- Fullscreen Image Popup -->
    @if (showImagePopup && !string.IsNullOrEmpty(popupImageUrl))
    {
        <div class="image-popup-overlay" @onclick="CloseImagePopup">
            <div class="image-popup-container">
                <button class="popup-close-btn" @onclick="CloseImagePopup">&times;</button>
                <img src="@popupImageUrl" alt="Full size image" class="popup-image"
                     @onclick:stopPropagation @ondblclick="CloseImagePopup" />
            </div>
        </div>
    }
</div>

<style>
    .text-search-row {
        display: flex;
        gap: 8px;
    }

    .text-search-input {
        flex: 1;
    }

    .search-btn {
        padding: 8px 16px;
        background: #3b82f6;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-weight: 500;
    }

    .search-btn:hover:not(:disabled) {
        background: #2563eb;
    }

    .search-btn:disabled {
        background: #9ca3af;
        cursor: not-allowed;
    }

    .divider-text {
        text-align: center;
        color: #6b7280;
        font-size: 0.875rem;
        margin: 12px 0;
        position: relative;
    }

    .divider-text::before,
    .divider-text::after {
        content: '';
        position: absolute;
        top: 50%;
        width: 30%;
        height: 1px;
        background: #374151;
    }

    .divider-text::before {
        left: 0;
    }

    .divider-text::after {
        right: 0;
    }

    /* Results header layout */
    .results-title-row {
        display: flex;
        align-items: baseline;
        gap: 12px;
    }

    /* Thumbnail size selector */
    .thumbnail-size-selector {
        display: flex;
        gap: 4px;
        background: #1f2937;
        padding: 4px;
        border-radius: 6px;
    }

    .size-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        background: transparent;
        border: none;
        border-radius: 4px;
        color: #9ca3af;
        cursor: pointer;
        transition: all 0.15s;
    }

    .size-btn:hover {
        background: #374151;
        color: #e5e7eb;
    }

    .size-btn.active {
        background: #3b82f6;
        color: white;
    }

    /* Grid size variations */
    .results-grid-small {
        grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)) !important;
    }

    .results-grid-medium {
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)) !important;
    }

    .results-grid-large {
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)) !important;
    }

    /* Adjust card info for small size */
    .results-grid-small .result-info {
        padding: 0.5rem;
    }

    .results-grid-small .result-filename {
        font-size: 0.65rem;
    }

    .results-grid-small .result-stats {
        font-size: 0.6rem;
    }

    .results-grid-small .open-btn {
        font-size: 0.65rem;
        padding: 4px 8px;
    }

    .results-grid-small .rank-badge {
        font-size: 0.6rem;
        width: 24px;
        height: 24px;
    }

    /* Deep Search button */
    .deep-search-btn {
        padding: 6px 14px;
        background: linear-gradient(135deg, #8b5cf6, #3b82f6);
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.2s;
        margin-left: auto;
    }

    .deep-search-btn:hover:not(:disabled) {
        background: linear-gradient(135deg, #7c3aed, #2563eb);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
    }

    .deep-search-btn:disabled {
        background: #6b7280;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    /* History button */
    .history-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        background: #374151;
        color: #d1d5db;
        border: 1px solid #4b5563;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.85rem;
        transition: all 0.2s;
    }

    .history-btn:hover {
        background: #4b5563;
        color: #f3f4f6;
    }

    /* History panel overlay */
    .history-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 100;
    }

    /* History panel */
    .history-panel {
        position: fixed;
        top: 0;
        right: 0;
        width: 320px;
        height: 100vh;
        background: #1f2937;
        border-left: 1px solid #374151;
        z-index: 101;
        display: flex;
        flex-direction: column;
        animation: slideIn 0.2s ease-out;
    }

    @@keyframes slideIn {
        from { transform: translateX(100%); }
        to { transform: translateX(0); }
    }

    .history-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px;
        border-bottom: 1px solid #374151;
    }

    .history-panel-header h3 {
        margin: 0;
        color: #f3f4f6;
        font-size: 1.1rem;
    }

    .close-btn {
        background: transparent;
        border: none;
        color: #9ca3af;
        font-size: 24px;
        cursor: pointer;
        line-height: 1;
    }

    .close-btn:hover {
        color: #f3f4f6;
    }

    .history-loading, .history-empty {
        padding: 40px 20px;
        text-align: center;
        color: #9ca3af;
    }

    .spinner-sm {
        width: 24px;
        height: 24px;
        border: 2px solid #374151;
        border-top-color: #3b82f6;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 12px;
    }

    .history-list {
        flex: 1;
        overflow-y: auto;
        padding: 8px;
    }

    .history-item {
        display: flex;
        gap: 12px;
        padding: 10px;
        background: #111827;
        border-radius: 8px;
        margin-bottom: 8px;
        cursor: pointer;
        transition: all 0.15s;
    }

    .history-item:hover {
        background: #1e3a5f;
        transform: translateX(-4px);
    }

    .history-item-image {
        width: 50px;
        height: 50px;
        flex-shrink: 0;
        border-radius: 6px;
        overflow: hidden;
        background: #374151;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .history-item-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .history-text-icon, .history-no-image {
        color: #9ca3af;
        font-size: 1.2rem;
        font-weight: bold;
    }

    .history-item-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
    }

    .history-type {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 2px 6px;
        border-radius: 4px;
        width: fit-content;
    }

    .history-type.dino { background: #7c3aed; color: white; }
    .history-type.clip { background: #3b82f6; color: white; }
    .history-type.deep { background: linear-gradient(135deg, #8b5cf6, #3b82f6); color: white; }
    .history-type.face { background: #10b981; color: white; }
    .history-type.text { background: #f59e0b; color: black; }

    .history-date {
        font-size: 0.75rem;
        color: #9ca3af;
    }

    .history-results {
        font-size: 0.8rem;
        color: #d1d5db;
    }

    /* Fullscreen Image Popup */
    .image-popup-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.95);
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        animation: fadeIn 0.2s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .image-popup-container {
        position: relative;
        max-width: 95vw;
        max-height: 95vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .popup-image {
        max-width: 95vw;
        max-height: 95vh;
        object-fit: contain;
        cursor: zoom-out;
        border-radius: 4px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    }

    .popup-close-btn {
        position: fixed;
        top: 20px;
        right: 20px;
        width: 48px;
        height: 48px;
        background: rgba(255, 255, 255, 0.1);
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        color: white;
        font-size: 28px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        z-index: 201;
    }

    .popup-close-btn:hover {
        background: rgba(255, 255, 255, 0.2);
        border-color: rgba(255, 255, 255, 0.5);
        transform: scale(1.1);
    }

    /* Make result images show they're double-clickable */
    .result-image-container {
        cursor: zoom-in;
    }

</style>

@code {
    private List<string> collections = new() { "books" };
    private string selectedCollection = "books";
    private int topK = 50;
    private bool verify = true;
    private string textQuery = "";
    private string lastSearchType = "";
    private string thumbnailSize = "medium";

    private List<SearchResult> results = new();
    private StatsResponse? stats;
    private ClipStatsResponse? clipStats;
    private string? errorMessage;
    private bool isSearching = false;
    private bool hasSearched = false;
    private bool isDragging = false;

    // CLIP file state
    private string? clipPreviewUrl;
    private IBrowserFile? clipSelectedFile;
    private byte[]? clipFileBytes;

    // DINOv2 file state
    private string? dinoPreviewUrl;
    private IBrowserFile? dinoSelectedFile;
    private byte[]? dinoFileBytes;

    // Face file state
    private string? facePreviewUrl;
    private IBrowserFile? faceSelectedFile;
    private byte[]? faceFileBytes;

    // History state
    private bool showHistoryPanel = false;
    private bool isLoadingHistory = false;
    private List<SearchHistoryEntry>? historyEntries;

    // Image popup state
    private bool showImagePopup = false;
    private string? popupImageUrl;

    protected override async Task OnInitializedAsync()
    {
        await LoadCollections();
        await LoadStats();
        await LoadClipStats();
    }

    private async Task LoadCollections()
    {
        try
        {
            var cols = await SearchService.GetCollectionsAsync();
            if (cols.Any())
            {
                var baseNames = cols
                    .Select(c => c.Replace("_visual", "").Replace("_faces", ""))
                    .Distinct()
                    .ToList();

                if (baseNames.Any())
                {
                    collections = baseNames;
                    selectedCollection = collections.First();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load collections");
        }
    }

