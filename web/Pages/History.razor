@page "/history"
@inject ISearchService SearchService
@inject ILogger<History> Logger
@inject NavigationManager Navigation

<PageTitle>Search History - Deception Lens</PageTitle>

<div class="history-container">
    <header class="history-header">
        <h1>Search History</h1>
        <div class="filter-controls">
            <select @bind="selectedType" @bind:after="LoadHistory" class="form-select">
                <option value="">All Types</option>
                <option value="DINOv2 Visual">DINOv2</option>
                <option value="CLIP Visual">CLIP</option>
                <option value="Deep Search">Deep Search</option>
                <option value="Face Search">Face</option>
                <option value="Text">Text</option>
            </select>
        </div>
    </header>

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="spinner"></div>
            <p>Loading history...</p>
        </div>
    }
    else if (historyResponse == null || !historyResponse.Entries.Any())
    {
        <div class="empty-state">
            <p>No search history found.</p>
            <a href="/" class="back-link">Go to Search</a>
        </div>
    }
    else
    {
        <div class="history-list">
            @foreach (var entry in historyResponse.Entries)
            {
                <div class="history-card" @onclick="() => ViewDetails(entry.Id)">
                    <div class="history-card-image">
                        @if (!string.IsNullOrEmpty(entry.QueryImageName))
                        {
                            <img src="@SearchService.GetSearchHistoryImageUrl(entry.Id)"
                                 alt="Query"
                                 loading="lazy"
                                 @onerror="HandleImageError" />
                        }
                        else if (!string.IsNullOrEmpty(entry.QueryText))
                        {
                            <div class="text-query-preview">
                                <span>"@entry.QueryText"</span>
                            </div>
                        }
                        else
                        {
                            <div class="no-preview">
                                <span>No preview</span>
                            </div>
                        }
                    </div>
                    <div class="history-card-info">
                        <div class="history-card-header">
                            <span class="search-type-badge @GetTypeBadgeClass(entry.SearchType)">
                                @entry.SearchType
                            </span>
                            <span class="search-date">@FormatDate(entry.ParsedDate)</span>
                        </div>
                        <div class="history-card-details">
                            <p><strong>Results:</strong> @entry.ResultCount</p>
                            @if (entry.SearchDurationMs.HasValue)
                            {
                                <p><strong>Duration:</strong> @FormatDuration(entry.SearchDurationMs.Value)</p>
                            }
                            @if (!string.IsNullOrEmpty(entry.TopResultPath))
                            {
                                <p class="top-result"><strong>Top:</strong> @GetFileName(entry.TopResultPath)</p>
                            }
                        </div>
                    </div>
                    <div class="history-card-actions">
                        <button class="btn-icon" @onclick:stopPropagation="true" @onclick="() => DeleteEntry(entry.Id)" title="Delete">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/>
                            </svg>
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (historyResponse.Total > historyResponse.PageSize)
        {
            <div class="pagination">
                <button class="page-btn" disabled="@(currentPage <= 1)" @onclick="PreviousPage">Previous</button>
                <span class="page-info">Page @currentPage of @TotalPages</span>
                <button class="page-btn" disabled="@(currentPage >= TotalPages)" @onclick="NextPage">Next</button>
            </div>
        }
    }

    <!-- Detail Modal -->
    @if (selectedDetail != null)
    {
        <div class="modal-overlay" @onclick="CloseDetail">
            <div class="modal-content" @onclick:stopPropagation="true">
                <button class="modal-close" @onclick="CloseDetail">&times;</button>

                <div class="modal-header">
                    <h2>Search Details</h2>
                    <span class="search-type-badge @GetTypeBadgeClass(selectedDetail.SearchType)">
                        @selectedDetail.SearchType
                    </span>
                </div>

                <div class="modal-body">
                    <div class="detail-query">
                        @if (!string.IsNullOrEmpty(selectedDetail.QueryImageName))
                        {
                            <img src="@SearchService.GetSearchHistoryImageUrl(selectedDetail.Id)"
                                 alt="Query Image"
                                 class="query-image" />
                        }
                        <div class="detail-meta">
                            <p><strong>Date:</strong> @FormatDate(DateTime.Parse(selectedDetail.SearchDate))</p>
                            <p><strong>Results:</strong> @selectedDetail.ResultCount</p>
                            @if (selectedDetail.SearchDurationMs.HasValue)
                            {
                                <p><strong>Duration:</strong> @FormatDuration(selectedDetail.SearchDurationMs.Value)</p>
                            }
                            @if (!string.IsNullOrEmpty(selectedDetail.Collection))
                            {
                                <p><strong>Collection:</strong> @selectedDetail.Collection</p>
                            }
                        </div>
                    </div>

                    <h3>Results</h3>
                    <div class="detail-results">
                        @foreach (var result in selectedDetail.Results.Take(20))
                        {
                            <div class="detail-result-card">
                                <img src="@SearchService.GetImageUrl(result.ImagePath)"
                                     alt="Result @result.Rank"
                                     loading="lazy" />
                                <div class="result-info">
                                    <span class="rank">#@result.Rank</span>
                                    <span class="filename" title="@result.ImagePath">@result.FileName</span>
                                    <span class="score">@result.Score.ToString("F4")</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .history-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px;
    }

    .history-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .history-header h1 {
        color: #f3f4f6;
        margin: 0;
    }

    .filter-controls .form-select {
        background: #1f2937;
        border: 1px solid #374151;
        color: #f3f4f6;
        padding: 8px 12px;
        border-radius: 6px;
    }

    .history-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .history-card {
        display: flex;
        background: #1f2937;
        border: 1px solid #374151;
        border-radius: 8px;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.2s;
    }

    .history-card:hover {
        border-color: #3b82f6;
        transform: translateX(4px);
    }

    .history-card-image {
        width: 100px;
        height: 80px;
        flex-shrink: 0;
        background: #111827;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .history-card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .text-query-preview, .no-preview {
        padding: 8px;
        text-align: center;
        color: #9ca3af;
        font-size: 0.75rem;
    }

    .history-card-info {
        flex: 1;
        padding: 12px 16px;
    }

    .history-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .search-type-badge {
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .search-type-badge.dino { background: #7c3aed; color: white; }
    .search-type-badge.clip { background: #3b82f6; color: white; }
    .search-type-badge.deep { background: linear-gradient(135deg, #8b5cf6, #3b82f6); color: white; }
    .search-type-badge.face { background: #10b981; color: white; }
    .search-type-badge.text { background: #f59e0b; color: black; }

    .search-date {
        color: #9ca3af;
        font-size: 0.8rem;
    }

    .history-card-details {
        font-size: 0.85rem;
        color: #d1d5db;
    }

    .history-card-details p {
        margin: 4px 0;
    }

    .top-result {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .history-card-actions {
        display: flex;
        align-items: center;
        padding: 0 12px;
    }

    .btn-icon {
        background: transparent;
        border: none;
        color: #9ca3af;
        cursor: pointer;
        padding: 8px;
        border-radius: 4px;
        transition: all 0.2s;
    }

    .btn-icon:hover {
        background: #374151;
        color: #ef4444;
    }

    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 16px;
        margin-top: 24px;
    }

    .page-btn {
        padding: 8px 16px;
        background: #3b82f6;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
    }

    .page-btn:disabled {
        background: #374151;
        cursor: not-allowed;
    }

    .page-info {
        color: #9ca3af;
    }

    /* Modal */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-content {
        background: #1f2937;
        border-radius: 12px;
        max-width: 900px;
        max-height: 90vh;
        overflow-y: auto;
        position: relative;
        width: 90%;
    }

    .modal-close {
        position: absolute;
        top: 12px;
        right: 12px;
        background: transparent;
        border: none;
        color: #9ca3af;
        font-size: 24px;
        cursor: pointer;
    }

    .modal-header {
        padding: 20px 24px;
        border-bottom: 1px solid #374151;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .modal-header h2 {
        margin: 0;
        color: #f3f4f6;
    }

    .modal-body {
        padding: 24px;
    }

    .detail-query {
        display: flex;
        gap: 20px;
        margin-bottom: 24px;
    }

    .query-image {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border-radius: 8px;
    }

    .detail-meta p {
        margin: 8px 0;
        color: #d1d5db;
    }

    .modal-body h3 {
        color: #f3f4f6;
        margin-bottom: 16px;
    }

    .detail-results {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 12px;
    }

    .detail-result-card {
        background: #111827;
        border-radius: 8px;
        overflow: hidden;
    }

    .detail-result-card img {
        width: 100%;
        height: 100px;
        object-fit: cover;
    }

    .detail-result-card .result-info {
        padding: 8px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .detail-result-card .rank {
        font-weight: bold;
        color: #3b82f6;
    }

    .detail-result-card .filename {
        font-size: 0.7rem;
        color: #9ca3af;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .detail-result-card .score {
        font-size: 0.75rem;
        color: #10b981;
    }

    .loading-container, .empty-state {
        text-align: center;
        padding: 60px;
        color: #9ca3af;
    }

    .back-link {
        color: #3b82f6;
        text-decoration: none;
    }

    .back-link:hover {
        text-decoration: underline;
    }
</style>

@code {
    private SearchHistoryListResponse? historyResponse;
    private SearchHistoryDetail? selectedDetail;
    private bool isLoading = true;
    private int currentPage = 1;
    private int pageSize = 20;
    private string selectedType = "";

    private int TotalPages => historyResponse != null
        ? (int)Math.Ceiling((double)historyResponse.Total / historyResponse.PageSize)
        : 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadHistory();
    }

    private async Task LoadHistory()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            historyResponse = await SearchService.GetSearchHistoryAsync(
                page: currentPage,
                pageSize: pageSize,
                searchType: string.IsNullOrEmpty(selectedType) ? null : selectedType
            );
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load history");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ViewDetails(int searchId)
    {
        try
        {
            selectedDetail = await SearchService.GetSearchHistoryDetailAsync(searchId);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load search details");
        }
    }

    private void CloseDetail()
    {
        selectedDetail = null;
    }

    private async Task DeleteEntry(int searchId)
    {
        if (await SearchService.DeleteSearchHistoryAsync(searchId))
        {
            await LoadHistory();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadHistory();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
            await LoadHistory();
        }
    }

    private string GetTypeBadgeClass(string searchType)
    {
        return searchType switch
        {
            "DINOv2 Visual" => "dino",
            "CLIP Visual" => "clip",
            "Deep Search" => "deep",
            "Face Search" => "face",
            _ when searchType.Contains("Text") => "text",
            _ => ""
        };
    }

    private string FormatDate(DateTime date)
    {
        if (date.Date == DateTime.Today)
            return $"Today {date:HH:mm}";
        if (date.Date == DateTime.Today.AddDays(-1))
            return $"Yesterday {date:HH:mm}";
        return date.ToString("MMM d, HH:mm");
    }

    private string FormatDuration(int ms)
    {
        if (ms < 1000)
            return $"{ms}ms";
        return $"{ms / 1000.0:F1}s";
    }

    private string GetFileName(string path)
    {
        return System.IO.Path.GetFileName(path);
    }

    private void HandleImageError()
    {
        // Handle broken images
    }
}
