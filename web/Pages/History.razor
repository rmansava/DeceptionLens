@page "/history"
@implements IDisposable
@inject ISearchService SearchService
@inject ILogger<History> Logger
@inject NavigationManager Navigation

<PageTitle>Search History - Deception Lens</PageTitle>

@if (selectedDetail != null)
{
    <!-- Full-page detail view -->
    <div class="detail-page">
        <header class="detail-page-header">
            <button class="btn-back-page" @onclick="CloseDetail">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 12H5M12 19l-7-7 7-7"/>
                </svg>
                Back to History
            </button>
            <div class="detail-page-title">
                <span class="search-type-badge @GetTypeBadgeClass(selectedDetail.SearchType)">
                    @selectedDetail.SearchType
                </span>
                @if (selectedDetail.IsInProgress)
                {
                    <span class="status-badge status-running">Searching...</span>
                    <button class="btn-stop-detail" @onclick="() => StopEntry(selectedDetail.Id)">Stop</button>
                }
                else if (IsResumableDisk(selectedDetail))
                {
                    <button class="btn-stop-detail" @onclick="() => ResumeEntry(selectedDetail.Id)">Resume</button>
                }
                <span class="search-date">@FormatDate(DateTime.Parse(selectedDetail.SearchDate))</span>
            </div>
        </header>

        <div class="detail-page-layout">
            <!-- Left: Query info sidebar -->
            <aside class="detail-sidebar">
                @if (!string.IsNullOrEmpty(selectedDetail.QueryImageName))
                {
                    <img src="@SearchService.GetSearchHistoryImageUrl(selectedDetail.Id)"
                         alt="Query Image"
                         class="detail-query-image" />
                }
                <div class="detail-meta">
                    <p><strong>@selectedDetail.QueryImageName</strong></p>
                    <p>@selectedDetail.ResultCount results</p>
                    @if (selectedDetail.IsInProgress)
                    {
                        <div class="detail-progress">
                            <div class="progress-bar-container">
                                <div class="progress-bar-fill" style="width: @GetDetailProgressPercent()%"></div>
                            </div>
                            <span class="progress-text">@(selectedDetail.CurrentProgress ?? "Starting...")</span>
                            @if (selectedDetail.SearchDurationMs.HasValue)
                            {
                                <p>Elapsed: @FormatDuration(selectedDetail.SearchDurationMs.Value)</p>
                            }
                        </div>
                    }
                    else if (selectedDetail.SearchDurationMs.HasValue)
                    {
                        <p>Duration: @FormatDuration(selectedDetail.SearchDurationMs.Value)</p>
                    }
                    @if (!string.IsNullOrEmpty(selectedDetail.Collection))
                    {
                        <p>Collection: @selectedDetail.Collection</p>
                    }
                </div>
            </aside>

            <!-- Right: Results area -->
            <section class="detail-results-area">
                @if (selectedResult != null)
                {
                    <div class="compare-section">
                        <div class="compare-header">
                            <h3>Comparing: #@selectedResult.Rank - @selectedResult.FileName</h3>
                            <button class="btn-back" @onclick="ClearSelectedResult">Back to results</button>
                        </div>
                        <div class="compare-images">
                            <div class="compare-card">
                                <h4>Query Image</h4>
                                <img src="@SearchService.GetSearchHistoryImageUrl(selectedDetail.Id)"
                                     alt="Query" />
                            </div>
                            <div class="compare-card">
                                <h4>Match - @(selectedResult.VerifiedMatches.HasValue ? $"{selectedResult.VerifiedMatches} votes" : selectedResult.Score.ToString("F4"))</h4>
                                <img src="@SearchService.GetImageUrl(selectedResult.ImagePath)"
                                     alt="Result" />
                                <p class="compare-path" title="@selectedResult.ImagePath">@selectedResult.ImagePath</p>
                            </div>
                        </div>
                    </div>
                }

                <div class="results-title-row">
                    <h2>Results @(selectedDetail.IsInProgress ? "(updating live)" : "")</h2>
                    <div class="thumbnail-size-selector">
                        <button class="size-btn @(thumbnailSize == "small" ? "active" : "")" @onclick="@(() => thumbnailSize = "small")" title="Small thumbnails">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                                <rect x="1" y="1" width="3" height="3" /><rect x="6" y="1" width="3" height="3" /><rect x="11" y="1" width="3" height="3" />
                                <rect x="1" y="6" width="3" height="3" /><rect x="6" y="6" width="3" height="3" /><rect x="11" y="6" width="3" height="3" />
                                <rect x="1" y="11" width="3" height="3" /><rect x="6" y="11" width="3" height="3" /><rect x="11" y="11" width="3" height="3" />
                            </svg>
                        </button>
                        <button class="size-btn @(thumbnailSize == "medium" ? "active" : "")" @onclick="@(() => thumbnailSize = "medium")" title="Medium thumbnails">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                                <rect x="1" y="1" width="6" height="6" /><rect x="9" y="1" width="6" height="6" />
                                <rect x="1" y="9" width="6" height="6" /><rect x="9" y="9" width="6" height="6" />
                            </svg>
                        </button>
                        <button class="size-btn @(thumbnailSize == "large" ? "active" : "")" @onclick="@(() => thumbnailSize = "large")" title="Large thumbnails">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                                <rect x="1" y="1" width="14" height="6" />
                                <rect x="1" y="9" width="14" height="6" />
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="results-grid results-grid-@thumbnailSize">
                    @foreach (var (result, index) in selectedDetail.Results.Select((r, i) => (r, i)))
                    {
                        <div class="result-card @(result == selectedResult ? "selected-card" : "")" @onclick="() => SelectResult(result)">
                            <div class="result-image-container">
                                <img src="@SearchService.GetImageUrl(result.ImagePath)"
                                     alt="Result @result.Rank"
                                     loading="lazy" />
                                <span class="rank-badge">#@result.Rank</span>
                            </div>
                            <div class="result-info">
                                <h3 class="result-filename" title="@result.ImagePath">@result.FileName</h3>
                                <div class="result-stats">
                                    @if (result.VerifiedMatches.HasValue && result.VerifiedMatches > 0)
                                    {
                                        <span class="verified-badge verified-positive">@result.VerifiedMatches votes</span>
                                    }
                                    <span class="score-badge">Score: @result.Score.ToString("F4")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>
}
else
{
    <!-- History list view -->
    <div class="history-container">
        <header class="history-header">
            <div class="history-header-left">
                <button class="btn-back-page" @onclick="GoToSearch">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 12H5M12 19l-7-7 7-7"/>
                    </svg>
                    Search
                </button>
                <h1>Search History</h1>
            </div>
            <div class="filter-controls">
                <select @bind="selectedType" @bind:after="LoadHistory" class="form-select">
                    <option value="">All Types</option>
                    <option value="DINOv2 Visual">DINOv2</option>
                    <option value="CLIP Visual">CLIP</option>
                    <option value="Face Search">Face</option>
                    <option value="DISK Keypoint">DISK Keypoint</option>
                    <option value="Text">Text</option>
                </select>
            </div>
        </header>

        @if (isLoading)
        {
            <div class="loading-container">
                <div class="spinner"></div>
                <p>Loading history...</p>
            </div>
        }
        else if (historyResponse == null || !historyResponse.Entries.Any())
        {
            <div class="empty-state">
                <p>No search history found.</p>
                <a href="/" class="back-link">Go to Search</a>
            </div>
        }
        else
        {
            <div class="history-list">
                @foreach (var entry in historyResponse.Entries)
                {
                    <div class="history-card @(entry.IsInProgress ? "in-progress" : "")" @onclick="() => ViewDetails(entry.Id)">
                        <div class="history-card-image">
                            @if (!string.IsNullOrEmpty(entry.QueryImageName))
                            {
                                <img src="@SearchService.GetSearchHistoryImageUrl(entry.Id)"
                                     alt="Query"
                                     loading="lazy"
                                     @onerror="HandleImageError" />
                            }
                            else if (!string.IsNullOrEmpty(entry.QueryText))
                            {
                                <div class="text-query-preview">
                                    <span>"@entry.QueryText"</span>
                                </div>
                            }
                            else
                            {
                                <div class="no-preview">
                                    <span>No preview</span>
                                </div>
                            }
                        </div>
                        <div class="history-card-info">
                            <div class="history-card-header">
                                <span class="search-type-badge @GetTypeBadgeClass(entry.SearchType)">
                                    @entry.SearchType
                                </span>
                                @if (entry.IsInProgress)
                                {
                                    <span class="status-badge status-running">Searching...</span>
                                }
                                else if (entry.Status == "stopped")
                                {
                                    <span class="status-badge status-stopped">Stopped</span>
                                }
                                else if (entry.Status == "failed")
                                {
                                    <span class="status-badge status-failed">Failed</span>
                                }
                                @if (entry.HasPossibleHit)
                                {
                                    <span class="hit-badge">Possible Hit (@entry.TopResultVotes votes)</span>
                                }
                                <span class="search-date">@FormatDate(entry.ParsedDate)</span>
                            </div>
                            @if (entry.IsInProgress)
                            {
                                <div class="progress-section">
                                    <div class="progress-bar-container">
                                        <div class="progress-bar-fill" style="width: @entry.ProgressPercent.ToString("F1")%"></div>
                                    </div>
                                    <span class="progress-text">@(entry.CurrentProgress ?? "Starting...") (@entry.ProgressPercent.ToString("F1")%)</span>
                                </div>
                            }
                            <div class="history-card-details">
                                <p><strong>Results:</strong> @entry.ResultCount</p>
                                @if (entry.SearchDurationMs.HasValue && !entry.IsInProgress)
                                {
                                    <p><strong>Duration:</strong> @FormatDuration(entry.SearchDurationMs.Value)</p>
                                }
                                else if (entry.IsInProgress && entry.SearchDurationMs.HasValue)
                                {
                                    <p><strong>Elapsed:</strong> @FormatDuration(entry.SearchDurationMs.Value)</p>
                                }
                                @if (entry.TopResultVotes.HasValue && entry.TopResultVotes > 0)
                                {
                                    <p><strong>Top Votes:</strong> @entry.TopResultVotes.Value.ToString("N0")</p>
                                }
                                @if (!string.IsNullOrEmpty(entry.TopResultPath))
                                {
                                    <p class="top-result"><strong>Top:</strong> @GetFileName(entry.TopResultPath)</p>
                                }
                            </div>
                        </div>
                        <div class="history-card-actions">
                            @if (entry.IsInProgress)
                            {
                                <button class="btn-icon btn-stop" @onclick:stopPropagation="true" @onclick="() => StopEntry(entry.Id)" title="Stop search">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                        <rect x="6" y="6" width="12" height="12" rx="1"/>
                                    </svg>
                                </button>
                            }
                            else if (IsResumableDisk(entry))
                            {
                                <button class="btn-icon btn-resume" @onclick:stopPropagation="true" @onclick="() => ResumeEntry(entry.Id)" title="Resume from next chunk">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M8 5v14l11-7z"/>
                                    </svg>
                                </button>
                            }
                            <button class="btn-icon" @onclick:stopPropagation="true" @onclick="() => DeleteEntry(entry.Id)" title="Delete">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (historyResponse.Total > historyResponse.PageSize)
            {
                <div class="pagination">
                    <button class="page-btn" disabled="@(currentPage <= 1)" @onclick="PreviousPage">Previous</button>
                    <span class="page-info">Page @currentPage of @TotalPages</span>
                    <button class="page-btn" disabled="@(currentPage >= TotalPages)" @onclick="NextPage">Next</button>
                </div>
            }
        }
    </div>
}

<style>
    /* ========== Detail Page (full page) ========== */
    .detail-page {
        padding: 16px 24px;
        max-width: 100%;
    }

    .detail-page-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid #374151;
    }

    .detail-page-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .btn-back-page {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        background: #374151;
        color: #d1d5db;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.85rem;
        transition: all 0.15s;
    }

    .btn-back-page:hover {
        background: #4b5563;
        color: #f3f4f6;
    }

    .detail-page-layout {
        display: flex;
        gap: 20px;
    }

    .detail-sidebar {
        width: 220px;
        flex-shrink: 0;
        position: sticky;
        top: 16px;
        align-self: flex-start;
    }

    .detail-query-image {
        width: 100%;
        border-radius: 8px;
        margin-bottom: 12px;
        background: #111827;
    }

    .detail-meta {
        font-size: 0.85rem;
        color: #d1d5db;
    }

    .detail-meta p {
        margin: 6px 0;
    }

    .detail-results-area {
        flex: 1;
        min-width: 0;
    }

    .results-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
    }

    .results-title-row h2 {
        color: #f3f4f6;
        margin: 0;
        font-size: 1.1rem;
    }

    /* Shared thumbnail controls/grid sizing are in css/results-shared.css */

    /* Selected card highlight */
    .selected-card {
        outline: 3px solid #3b82f6;
        outline-offset: 2px;
        border-radius: 0.75rem;
    }

    /* ========== History List ========== */
    .history-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px;
    }

    .history-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .history-header-left {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .history-header h1 {
        color: #f3f4f6;
        margin: 0;
    }

    .filter-controls .form-select {
        background: #1f2937;
        border: 1px solid #374151;
        color: #f3f4f6;
        padding: 8px 12px;
        border-radius: 6px;
    }

    .history-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .history-card {
        display: flex;
        background: #1f2937;
        border: 1px solid #374151;
        border-radius: 8px;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.2s;
    }

    .history-card:hover {
        border-color: #3b82f6;
        transform: translateX(4px);
    }

    .history-card-image {
        width: 100px;
        height: 80px;
        flex-shrink: 0;
        background: #111827;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .history-card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .text-query-preview, .no-preview {
        padding: 8px;
        text-align: center;
        color: #9ca3af;
        font-size: 0.75rem;
    }

    .history-card-info {
        flex: 1;
        min-width: 0;
        padding: 12px 16px;
    }

    .history-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
