    }

    .back-link {
        color: #3b82f6;
        text-decoration: none;
    }

    .back-link:hover {
        text-decoration: underline;
    }

    /* In-progress card */
    .history-card.in-progress {
        border-color: #f59e0b;
        border-width: 2px;
    }

    .status-badge {
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .status-running {
        background: #f59e0b;
        color: black;
        animation: pulse-bg 2s ease-in-out infinite;
    }

    .status-stopped {
        background: #6b7280;
        color: white;
    }

    .status-failed {
        background: #ef4444;
        color: white;
    }

    @@keyframes pulse-bg {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.6; }
    }

    .progress-section {
        margin: 6px 0;
    }

    .progress-bar-container {
        width: 100%;
        height: 6px;
        background: #374151;
        border-radius: 3px;
        overflow: hidden;
    }

    .progress-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #f59e0b, #f97316);
        border-radius: 3px;
        transition: width 0.5s ease;
    }

    .progress-text {
        font-size: 0.7rem;
        color: #f59e0b;
        margin-top: 2px;
        display: block;
    }

    .hit-badge {
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 700;
        background: #dc2626;
        color: white;
        margin-left: 6px;
    }

    .detail-progress {
        margin: 8px 0;
    }

    /* Compare view */
    .compare-section {
        margin-bottom: 24px;
        background: #111827;
        border-radius: 8px;
        padding: 16px;
        border: 1px solid #374151;
    }

    .compare-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .compare-header h3 {
        margin: 0;
        font-size: 0.9rem;
        color: #f3f4f6;
    }

    .btn-back {
        padding: 4px 12px;
        background: #374151;
        color: #d1d5db;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.8rem;
    }

    .btn-back:hover {
        background: #4b5563;
    }

    .compare-images {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .compare-card {
        text-align: center;
    }

    .compare-card h4 {
        margin: 0 0 8px 0;
        color: #9ca3af;
        font-size: 0.8rem;
    }

    .compare-card img {
        max-width: 100%;
        max-height: 500px;
        object-fit: contain;
        border-radius: 6px;
        background: #000;
    }

    .compare-path {
        font-size: 0.65rem;
        color: #6b7280;
        margin-top: 6px;
        word-break: break-all;
    }
</style>

@code {
    private SearchHistoryListResponse? historyResponse;
    private SearchHistoryDetail? selectedDetail;
    private SearchHistoryDetailResult? selectedResult;
    private bool isLoading = true;
    private int currentPage = 1;
    private int pageSize = 20;
    private string selectedType = "";
    private string thumbnailSize = "medium";
    private Timer? _refreshTimer;

    private int TotalPages => historyResponse != null
        ? (int)Math.Ceiling((double)historyResponse.Total / historyResponse.PageSize)
        : 1;

    private bool HasInProgressEntries => historyResponse?.Entries?.Any(e => e.IsInProgress) == true;

    protected override async Task OnInitializedAsync()
    {
        await LoadHistory();
        StartAutoRefreshIfNeeded();
    }

    private void StartAutoRefreshIfNeeded()
    {
        if ((HasInProgressEntries || (selectedDetail != null && selectedDetail.IsInProgress)) && _refreshTimer == null)
        {
            _refreshTimer = new Timer(async _ =>
            {
                await InvokeAsync(async () =>
                {
                    await RefreshSilent();
                    if (!HasInProgressEntries && !(selectedDetail != null && selectedDetail.IsInProgress))
                    {
                        _refreshTimer?.Dispose();
                        _refreshTimer = null;
                    }
                });
            }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
        }
    }

    private async Task RefreshSilent()
    {
        try
        {
            historyResponse = await SearchService.GetSearchHistoryAsync(
                page: currentPage,
                pageSize: pageSize,
                searchType: string.IsNullOrEmpty(selectedType) ? null : selectedType
            );

            // Also refresh the detail view if it's open and in-progress
            if (selectedDetail != null && selectedDetail.IsInProgress)
            {
                selectedDetail = await SearchService.GetSearchHistoryDetailAsync(selectedDetail.Id);
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to refresh history");
        }
    }

    private async Task LoadHistory()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            historyResponse = await SearchService.GetSearchHistoryAsync(
                page: currentPage,
                pageSize: pageSize,
                searchType: string.IsNullOrEmpty(selectedType) ? null : selectedType
            );
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load history");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            StartAutoRefreshIfNeeded();
        }
    }

    private async Task ViewDetails(int searchId)
    {
        try
        {
            selectedDetail = await SearchService.GetSearchHistoryDetailAsync(searchId);
            selectedResult = null;
            StateHasChanged();
            StartAutoRefreshIfNeeded();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load search details");
        }
    }

    private void CloseDetail()
    {
        selectedDetail = null;
        selectedResult = null;
    }

    private void SelectResult(SearchHistoryDetailResult result)
    {
        selectedResult = result == selectedResult ? null : result;
    }

    private void ClearSelectedResult()
    {
        selectedResult = null;
    }

    private void GoToSearch()
    {
        Navigation.NavigateTo("/");
    }

    private async Task StopEntry(int searchId)
    {
        if (await SearchService.StopSearchAsync(searchId))
        {
            await RefreshSilent();
        }
    }

    private async Task ResumeEntry(int searchId)
    {
        try
        {
            var resumed = await SearchService.ResumeDiskSearchAsync(searchId);
            if (resumed?.SearchId > 0)
            {
                selectedDetail = null;
                selectedResult = null;
                currentPage = 1;
                await LoadHistory();
                await ViewDetails(resumed.SearchId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to resume DISK search {SearchId}", searchId);
        }
    }

    private async Task DeleteEntry(int searchId)
    {
        if (await SearchService.DeleteSearchHistoryAsync(searchId))
        {
            if (selectedDetail?.Id == searchId)
            {
                selectedDetail = null;
                selectedResult = null;
            }
            await LoadHistory();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadHistory();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
            await LoadHistory();
        }
    }

    private double GetDetailProgressPercent()
    {
        if (selectedDetail?.TotalChunks is null or 0) return 0;
        if (selectedDetail.CurrentProgress != null && selectedDetail.CurrentProgress.Contains('/'))
        {
            var parts = selectedDetail.CurrentProgress.Split(' ').LastOrDefault()?.Split('/');
            if (parts?.Length == 2 && int.TryParse(parts[0], out var current))
                return (double)current / selectedDetail.TotalChunks.Value * 100;
        }
        return 0;
    }

    private string GetTypeBadgeClass(string searchType)
    {
        return searchType switch
        {
            "DINOv2 Visual" => "dino",
            "CLIP Visual" => "clip",
            "Deep Search" => "deep",
            "Face Search" => "face",
            _ when searchType.Contains("DISK") => "disk",
            _ when searchType.Contains("Text") => "text",
            _ => ""
        };
    }

    private static bool IsResumableDisk(SearchHistoryEntry entry)
    {
        return entry != null &&
               !entry.IsInProgress &&
               entry.SearchType.Contains("DISK", StringComparison.OrdinalIgnoreCase) &&
               (entry.Status == "stopped" || entry.Status == "failed");
    }

    private static bool IsResumableDisk(SearchHistoryDetail detail)
    {
        return detail != null &&
               !detail.IsInProgress &&
               detail.SearchType.Contains("DISK", StringComparison.OrdinalIgnoreCase) &&
               (detail.Status == "stopped" || detail.Status == "failed");
    }

    private string FormatDate(DateTime date)
    {
        if (date.Date == DateTime.Today)
            return $"Today {date:HH:mm}";
        if (date.Date == DateTime.Today.AddDays(-1))
            return $"Yesterday {date:HH:mm}";
        return date.ToString("MMM d, HH:mm");
    }

    private string FormatDuration(int ms)
    {
        if (ms < 1000)
            return $"{ms}ms";
        if (ms < 60000)
            return $"{ms / 1000.0:F1}s";
        if (ms < 3600000)
            return $"{ms / 60000.0:F1}m";
        return $"{ms / 3600000.0:F1}h";
    }

    private string GetFileName(string path)
    {
        return System.IO.Path.GetFileName(path);
    }

    private void HandleImageError()
    {
        // Handle broken images
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
