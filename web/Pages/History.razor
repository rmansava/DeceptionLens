        border-radius: 4px;
        transition: all 0.2s;
    }

    .btn-icon:hover {
        background: #374151;
        color: #ef4444;
    }

    .btn-icon.btn-stop {
        color: #f59e0b;
    }

    .btn-icon.btn-stop:hover {
        background: #374151;
        color: #ef4444;
    }

    .btn-icon.btn-resume {
        color: #10b981;
    }

    .btn-icon.btn-resume:hover {
        background: #374151;
        color: #34d399;
    }

    .btn-stop-detail {
        padding: 4px 12px;
        background: #dc2626;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .btn-stop-detail:hover {
        background: #b91c1c;
    }

    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 16px;
        margin-top: 24px;
